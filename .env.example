# Copia este archivo como ".env" (sin .example) y pega tu clave.
# Nunca subas el archivo .env a GitHub ni lo compartas.
#ANTHROPIC_API_KEY=pega-aqui-tu-clave

# Si YouTube dice "Sign in to confirm you're not a bot", descomenta UNA de estas dos:
# (1) usar las cookies de tu navegador (recomendado Firefox, con sesion iniciada en YouTube)
# COOKIES_BROWSER=firefox
# (2) o un archivo cookies.txt exportado desde el navegador
# COOKIES_FILE=C:\Users\Guillermo\Desktop\cookies.txt

# Opcionales
# ANALYSIS_MODEL=claude-haiku-4-5
# CHAT_MODEL=claude-haiku-4-5
# PORT=5000
# Duracion maxima de un analisis, en minutos (por defecto 120).
# MAX_DURATION=120
# Frames que se analizan en paralelo (por defecto 3). Sube a 5 si tu cuenta tiene limites altos y quieres ir mas rapido.
# ANALYSIS_WORKERS=3
# Cuanta cancha debe verse (0 a 1) para considerar una toma "plano general". Sube el valor si se
# cuelan planos cerrados; bajalo si la transmision casi no muestra planos generales.
# GRASS_MIN=0.40
